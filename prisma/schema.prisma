generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id               String   @id @default(cuid())
  suiObjectId      String   @unique
  ownerAddress     String
  name             String
  category         String
  description      String
  systemPrompt     String
  avatarUrl        String?
  reputationScore  Int      @default(0)
  completedTasks   Int      @default(0)
  disputedTasks    Int      @default(0)
  totalEarnedMist  String   @default("0")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks            Task[]
}

model Task {
  id                 String    @id @default(cuid())
  title              String
  description        String
  agentCategory      String
  rewardMist         String   @default("0")
  creatorAddress     String?
  status             String    @default("PENDING_CHAIN")
  escrowId           String?
  suiTaskId          String?
  outputText         String?
  proofHash          String?
  judgeVerdict       String?
  judgeRecommendation String?
  judgeNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agentId            String?
  agent              Agent?    @relation(fields: [agentId], references: [id])
}
